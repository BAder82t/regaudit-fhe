{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regaudit-fhe.vaultbytes.com/schemas/v2/envelope.json",
  "title": "regaudit-fhe audit envelope (report.v2)",
  "description": "The signed, regulator-facing artefact emitted by report.v2. The signed body carries the full security identity (issuer, key_id, public_key_fingerprint, deployment_id, audit_run_id, optional audience and model/dataset commitments) under a domain-separated Ed25519 signature; see docs/TRUST_SPEC.md. The receipt and timestamps are outside the signed body. Unknown fields are refused at every level of the envelope structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "algorithm_version",
    "primitive",
    "backend",
    "parameter_set",
    "parameter_set_hash",
    "regulations",
    "result",
    "input_commitments",
    "depth_budget",
    "issued_at",
    "issuer",
    "key_id",
    "public_key_fingerprint",
    "deployment_id",
    "audit_run_id",
    "trust_policy_version",
    "receipt"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "regaudit-fhe.report.v2"
    },
    "schema_version": {
      "type": "string",
      "const": "regaudit-fhe.report.v2"
    },
    "algorithm_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"
    },
    "primitive": {
      "type": "string",
      "enum": [
        "fairness",
        "provenance",
        "concordance",
        "calibration",
        "drift",
        "disagreement"
      ]
    },
    "backend": {
      "type": "string",
      "enum": [
        "plaintext",
        "tenseal-ckks",
        "openfhe-ckks",
        "lattigo-ckks"
      ]
    },
    "parameter_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "poly_modulus_degree",
        "security_bits",
        "multiplicative_depth",
        "coeff_mod_bit_sizes",
        "scaling_factor_bits",
        "library_version",
        "backend_version"
      ],
      "properties": {
        "backend": {
          "type": "string"
        },
        "poly_modulus_degree": {
          "type": "integer",
          "minimum": 0
        },
        "security_bits": {
          "type": "integer",
          "minimum": 128
        },
        "multiplicative_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "coeff_mod_bit_sizes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "scaling_factor_bits": {
          "type": "integer",
          "minimum": 0
        },
        "library_version": {
          "type": "string"
        },
        "backend_version": {
          "type": "string"
        }
      }
    },
    "parameter_set_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "regulations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "object",
      "description": "Primitive-specific output; conforms to the matching <primitive>.output.schema.json."
    },
    "input_commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "depth_budget": {
      "type": "object",
      "description": "declared = circuit-wide ceiling (MAX_DEPTH, 6), not the per-primitive spec or TenSEAL declared depth; consumed = observed multiplicative depth for this call.",
      "additionalProperties": false,
      "required": [
        "declared",
        "consumed"
      ],
      "properties": {
        "declared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "consumed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "signature_alg",
        "signature_b64",
        "public_key_pem"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature_alg": {
          "type": "string",
          "const": "Ed25519"
        },
        "signature_b64": {
          "type": "string",
          "minLength": 1
        },
        "public_key_pem": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "public_key_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the SubjectPublicKeyInfo DER of the signing key."
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audit_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "trust_policy_version": {
      "type": "integer",
      "minimum": 0
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "model_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dataset_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dp": {
      "type": "object"
    },
    "timestamps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer",
          "token_b64",
          "issued_at"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "token_b64": {
            "type": "string",
            "minLength": 1
          },
          "issued_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  }
}
