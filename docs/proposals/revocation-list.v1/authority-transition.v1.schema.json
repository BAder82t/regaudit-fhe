{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regaudit-fhe.vaultbytes.com/proposals/revocation-authority-transition.v1.schema.json",
  "title": "DRAFT, NOT PUBLISHED, NOT REGISTERED: regaudit-fhe revocation-authority ROUTINE transition (v1)",
  "description": "Old authority hands over to a new authority; the new authority proves possession. Signing inputs: b'regaudit-fhe/revocation-authority-transition/v1/sign-from\\x00' (old) and '.../sign-to\\x00' (new) followed by canonical_bytes of every member except 'signatures'. Not usable for compromise recovery. See docs/TRUST_REVOCATION_PROTOCOL_PROPOSAL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm_version", "issuer", "from_authority", "to_authority", "issued_at", "valid_until", "signatures"],
  "properties": {
    "schema": {"const": "regaudit-fhe.revocation-authority-transition"},
    "schema_version": {"const": 1},
    "algorithm_version": {"const": 1},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "from_authority": {"$ref": "#/$defs/authority"},
    "to_authority": {"$ref": "#/$defs/authority_with_key"},
    "issued_at": {"$ref": "#/$defs/time"},
    "valid_until": {"$ref": "#/$defs/time"},
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/signature"}, "to": {"$ref": "#/$defs/signature"}}
    }
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,6})?([Zz]|[+-]\\d{2}:\\d{2})$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signature_b64"],
      "properties": {"algorithm": {"const": "ed25519"}, "signature_b64": {"type": "string", "minLength": 88, "maxLength": 88}}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "key_fingerprint", "generation"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "key_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "generation": {"type": "integer", "minimum": 1}
      }
    },
    "authority_with_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "key_fingerprint", "generation", "public_key_pem"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "key_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "generation": {"type": "integer", "minimum": 1},
        "public_key_pem": {"type": "string", "maxLength": 4096}
      }
    }
  }
}
