{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regaudit-fhe.vaultbytes.com/proposals/revocation-authority-recovery.v1.schema.json",
  "title": "DRAFT, NOT PUBLISHED, NOT REGISTERED: regaudit-fhe revocation-authority COMPROMISE RECOVERY (v1)",
  "description": "Signed by the separately enrolled recovery anchor (never by the authority being replaced) and co-signed by the new authority as proof of possession. Signing inputs: b'regaudit-fhe/revocation-authority-recovery/v1/sign-anchor\\x00' and '.../sign-new-authority\\x00' followed by canonical_bytes of every member except 'signatures'. See docs/TRUST_REVOCATION_PROTOCOL_PROPOSAL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm_version", "issuer", "recovery_anchor", "recovery_epoch", "declares_compromised", "new_authority", "rebase", "issued_at", "valid_until", "signatures"],
  "properties": {
    "schema": {"const": "regaudit-fhe.revocation-authority-recovery"},
    "schema_version": {"const": 1},
    "algorithm_version": {"const": 1},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "recovery_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "key_fingerprint"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "key_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "recovery_epoch": {"type": "integer", "minimum": 1},
    "declares_compromised": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_fingerprint", "compromised_from"],
        "properties": {
          "key_fingerprint": {"$ref": "#/$defs/fingerprint"},
          "compromised_from": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]}
        }
      }
    },
    "new_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "key_fingerprint", "generation", "public_key_pem"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "key_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "generation": {"type": "integer", "minimum": 1},
        "public_key_pem": {"type": "string", "maxLength": 4096}
      }
    },
    "rebase": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "list_digest"],
          "properties": {"epoch": {"type": "integer", "minimum": 1}, "list_digest": {"$ref": "#/$defs/fingerprint"}}
        }
      ]
    },
    "issued_at": {"$ref": "#/$defs/time"},
    "valid_until": {"$ref": "#/$defs/time"},
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "new_authority"],
      "properties": {"anchor": {"$ref": "#/$defs/signature"}, "new_authority": {"$ref": "#/$defs/signature"}}
    }
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,6})?([Zz]|[+-]\\d{2}:\\d{2})$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signature_b64"],
      "properties": {"algorithm": {"const": "ed25519"}, "signature_b64": {"type": "string", "minLength": 88, "maxLength": 88}}
    }
  }
}
